# Copier en .env (racine, utilisé par docker-compose) ET/OU en vendor/trade-republic-mcp-server/.env
# (utilisé par ./scripts/start.sh). NE JAMAIS committer ces fichiers.

# --- Trade Republic (serveur MCP) ---
TRADE_REPUBLIC_PHONE_NUMBER=+33612345678
TRADE_REPUBLIC_PIN=1234
PORT=3006

# --- Interface web ---
MCP_URL=http://127.0.0.1:3006/mcp
WEB_HOST=127.0.0.1
WEB_PORT=8080

# --- Optionnel : module crypto ccxt (Binance) pour le backtester en ligne de commande ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
